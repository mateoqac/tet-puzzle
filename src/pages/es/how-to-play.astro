---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HowToPlayContent from "../../components/HowToPlayContent";

const title = "Como Jugar - Tet Puzzle";
const description = "Aprende a jugar Tet Puzzle, el desafiante juego de logica numerica. Guia completa con reglas, consejos y ejemplos.";
