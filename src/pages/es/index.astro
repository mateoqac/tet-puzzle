---
import BaseLayout from "../../layouts/BaseLayout.astro";
import App from "../../components/App";
import AdUnit from "../../components/AdUnit";
import { generateBeginnerPuzzle } from "../../lib/puzzleGenerator";
import SpeedInsights from "@vercel/speed-insights/astro";
import { getTranslations } from "../../i18n";

const puzzle = generateBeginnerPuzzle();
const t = getTranslations("es");

const siteUrl = "https://tetonor.app";
const title = "Tet Puzzle - Juego de Logica Numerica Gratis Online";
const description =
  "Juega Tet puzzle online, un desafiante juego de logica numerica. Empareja pares de numeros para crear sumas y productos en este puzzle de entrenamiento mental. Gratis para jugar diariamente.";
const imageUrl = `${siteUrl}/og-image.png`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Tet Puzzle",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/logo-512.png`,
        width: 512,
        height: 512,
      },
      foundingDate: "2024",
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Tet Puzzle",
      description: description,
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: ["en", "es"],
    },
    {
      "@type": "WebApplication",
      "@id": `${siteUrl}/es/#webapp`,
      name: "Tet Puzzle",
      url: `${siteUrl}/es/`,
      description: description,
      applicationCategory: "GameApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      browserRequirements: "Requires JavaScript enabled",
      inLanguage: "es-ES",
    },
    {
      "@type": "Game",
      "@id": `${siteUrl}/es/#game`,
      name: "Tet Puzzle",
      description:
        "Tet puzzle es un juego de logica numerica donde los jugadores emparejan pares de numeros para lograr sumas y productos objetivo.",
      gamePlatform: ["Web browser", "Mobile browser"],
      genre: ["Puzzle", "Logica", "Matematicas"],
      numberOfPlayers: {
        "@type": "QuantitativeValue",
        value: "1",
      },
      playMode: "SinglePlayer",
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Que es Tet puzzle?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Tet puzzle es un juego de logica numerica. Los jugadores deben emparejar pares de numeros de un grupo para rellenar celdas en una cuadricula, donde cada par debe satisfacer tanto un requisito de suma como de producto.",
          },
        },
        {
          "@type": "Question",
          name: "Como se juega Tet puzzle?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "En Tet puzzle, se te da una cuadricula con celdas que muestran sumas y productos objetivo. Debes seleccionar pares de numeros del grupo disponible que sumen el objetivo y se multipliquen para dar el producto. Cada numero solo puede usarse una vez.",
          },
        },
        {
          "@type": "Question",
          name: "Que hace a Tet puzzle desafiante?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Tet puzzle desafia a los jugadores con logica numerica y razonamiento matematico. Cada par de numeros debe usarse exactamente dos veces - una para suma y otra para multiplicacion.",
          },
        },
        {
          "@type": "Question",
          name: "Es gratis jugar Tet Puzzle?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Si, Tet Puzzle es completamente gratis. No requiere registro ni pago.",
          },
        },
        {
          "@type": "Question",
          name: "Con que frecuencia hay nuevos puzzles?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Un nuevo puzzle de Desafio Diario esta disponible cada dia. Tambien puedes jugar puzzles ilimitados en Juego Libre en cualquier momento.",
          },
        },
        {
          "@type": "Question",
          name: "Puedo jugar puzzles diarios anteriores?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Si! Visita el Archivo para acceder y jugar todos los puzzles de desafios diarios anteriores.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/es"
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  showFooter={false}
  lang="es"
>
  <Fragment slot="head">
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/es/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Tet Puzzle" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={`${siteUrl}/es/`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Additional Meta -->
    <meta
      name="keywords"
      content="tet puzzle, tetonor, puzzle numerico, juego de logica, rompecabezas, puzzle matematico, puzzle diario, puzzle gratis online, juego de aritmetica, logica numerica"
    />
    <meta name="author" content="Tet Puzzle" />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <div class="flex justify-center gap-8 max-w-[1400px] mx-auto">
    <aside
      class="hidden xl:block shrink-0 w-40 self-start sticky top-8"
      aria-hidden="true"
    >
      <AdUnit client:only="preact" slot="5475429127" />
    </aside>

    <main id="main-content" role="main" class="flex-initial min-w-0 w-full">
      <header class="sr-only">
        <h1>Juega Tet Puzzle Online Gratis - Juego de Logica Numerica</h1>
        <p>
          Tet puzzle es un desafiante juego de logica numerica. El puzzle presenta una
          cuadricula donde cada celda contiene un numero objetivo. Los jugadores deben encontrar pares
          de numeros de un grupo dado que tanto sumen el objetivo como se multipliquen
          para dar el producto. Cada numero del grupo solo puede usarse una vez,
          requiriendo deduccion logica cuidadosa para resolver toda la cuadricula. Esta
          version online te permite jugar puzzles Tet gratis, con diferentes
          niveles de dificultad desde facil hasta experto.
        </p>
      </header>

      <article itemscope itemtype="https://schema.org/Game">
        <meta itemprop="name" content="Tet Puzzle" />
        <meta itemprop="description" content={description} />
        <App client:load initialPuzzle={puzzle} initialLang="es" />
      </article>
    </main>

    <aside
      class="hidden xl:block shrink-0 w-40 self-start sticky top-8"
      aria-hidden="true"
    >
      <AdUnit client:only="preact" slot="4102637707" />
    </aside>
  </div>

  <!-- SEO Content Section -->
  <section class="max-w-3xl mx-auto px-4 py-12 mt-8 border-t border-gray-200">
    <h2 class="text-2xl font-serif text-black mb-6">Como Jugar Tet Puzzle</h2>
    <p class="text-gray-600 leading-relaxed mb-4">
      Tet Puzzle es un cautivador juego de logica numerica que desafia tu razonamiento matematico y habilidades de deduccion. Cada puzzle presenta una cuadricula de 4x4 con 16 celdas, donde cada celda muestra un numero objetivo que debes alcanzar usando pares de numeros de la tira inferior.
    </p>
    <p class="text-gray-600 leading-relaxed mb-4">
      La regla fundamental que hace unico a Tet Puzzle: <strong>cada par de numeros debe usarse exactamente dos veces</strong> - una para una operacion de suma y otra para multiplicacion. Esta restriccion requiere planificacion cuidadosa y pensamiento logico para resolver cada puzzle exitosamente.
    </p>
    <div class="bg-gray-50 border border-gray-200 p-6 my-6">
      <h3 class="text-lg font-serif text-black mb-3">Guia Rapida</h3>
      <ol class="text-gray-600 space-y-2 list-decimal list-inside">
        <li>Observa el numero objetivo mostrado en cada celda de la cuadricula</li>
        <li>Selecciona dos numeros de la tira de numeros debajo de la cuadricula</li>
        <li>Elige una operacion: suma (+) o multiplicacion (x)</li>
        <li>El resultado debe ser igual al numero objetivo de esa celda</li>
        <li>Recuerda: cada par de numeros debe aparecer en dos celdas - una para sumar, otra para multiplicar</li>
      </ol>
    </div>
    <p class="text-gray-600 leading-relaxed mb-6">
      <a href="/es/how-to-play/" class="text-black underline hover:no-underline">Lee la guia completa</a> para instrucciones detalladas, consejos y estrategias para dominar Tet Puzzle.
    </p>

    <h2 class="text-2xl font-serif text-black mb-6 mt-10">Preguntas Frecuentes</h2>

    <div class="space-y-4 mb-6">
      <details class="border border-gray-200 group">
        <summary class="p-4 cursor-pointer font-medium text-black list-none flex justify-between items-center">
          <span>Es gratis jugar Tet Puzzle?</span>
          <span class="text-gray-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <div class="px-4 pb-4">
          <p class="text-gray-600">Si! Tet Puzzle es completamente gratis. Sin registro, sin pagos, sin anuncios bloqueando el juego. Puedes jugar puzzles ilimitados en cualquier nivel de dificultad, incluyendo nuestro Desafio Diario que se actualiza cada dia a medianoche.</p>
        </div>
      </details>

      <details class="border border-gray-200 group">
        <summary class="p-4 cursor-pointer font-medium text-black list-none flex justify-between items-center">
          <span>Que hace diferente a Tet Puzzle de otros juegos de numeros?</span>
          <span class="text-gray-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <div class="px-4 pb-4">
          <p class="text-gray-600">A diferencia de juegos aritmeticos simples, Tet Puzzle requiere que pienses en las relaciones numericas de dos formas simultaneamente. Cada par de numeros debe satisfacer tanto una ecuacion de suma como de multiplicacion en algun lugar de la cuadricula. Esta doble restriccion crea un desafio logico unico que ejercita tanto el calculo como las habilidades de deduccion.</p>
        </div>
      </details>

      <details class="border border-gray-200 group">
        <summary class="p-4 cursor-pointer font-medium text-black list-none flex justify-between items-center">
          <span>Como funcionan los niveles de dificultad?</span>
          <span class="text-gray-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <div class="px-4 pb-4">
          <p class="text-gray-600"><strong>Facil:</strong> Todos los numeros son visibles en la tira, permitiendote enfocarte en aprender la mecanica. <strong>Moderado:</strong> Algunos numeros estan ocultos, requiriendo deduccion logica. <strong>Dificil:</strong> La mayoria de numeros estan ocultos, presentando un verdadero desafio para entusiastas de puzzles.</p>
        </div>
      </details>

      <details class="border border-gray-200 group">
        <summary class="p-4 cursor-pointer font-medium text-black list-none flex justify-between items-center">
          <span>Que es el Desafio Diario?</span>
          <span class="text-gray-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <div class="px-4 pb-4">
          <p class="text-gray-600">El Desafio Diario es un puzzle especial que es el mismo para todos los jugadores en todo el mundo. Un nuevo puzzle se publica cada dia a medianoche UTC. Completa puzzles diarios para construir tu racha y comparar tu tiempo con amigos. Tambien puedes acceder a todos los puzzles diarios anteriores en nuestro <a href="/es/daily/archive/" class="text-black underline">Archivo</a>.</p>
        </div>
      </details>
    </div>

    <p class="text-gray-600">
      <a href="/es/faq/" class="text-black underline hover:no-underline">Ver todas las preguntas frecuentes</a>
    </p>
  </section>

  <SpeedInsights />
</BaseLayout>
